# WibeChat Environment Configuration Template
# All sensitive values should be configured in Wrangler Secrets or Cloudflare Dashboard

# Single Business Admin
ADMIN_EMAIL=contact@bytenex.io

# WhatsApp Business API (Configured via Dashboard Settings or Worker Secrets)
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Cloudflare Inbuilt Email & OTP Delivery (Cloudflare Email Routing or Cloudflare Access Zero Trust)
# When using Cloudflare Email Routing (send_email binding), zero external keys are required.
# (Optional fallback provider):
RESEND_API_KEY=
FROM_EMAIL=contact@bytenex.io
