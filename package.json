{
  "name": "wibechat",
  "version": "1.0.0",
  "private": true,
  "description": "WibeChat - Open-Source Business Messaging Platform built 100% on Cloudflare Free Tier (Workers, D1, R2, Static Assets)",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "dev": "vite",
    "build": "vite build",
    "d1:init": "wrangler d1 execute waba-db --local --file=./schema.sql",
    "d1:init:prod": "wrangler d1 execute waba-db --remote --file=./schema.sql",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.7.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^4.152.0"
  }
}
